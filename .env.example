# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Через запятую, если несколько.
# Если пусто — бот переводит для любого, кто его найдёт.
ALLOWED_USER_IDS=

# Движок перевода: gemini (по умолчанию, есть бесплатный тариф) или claude
TRANSLATOR=gemini

# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Только для TRANSLATOR=claude. Ключ: https://platform.claude.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
